# Copy to moot/.env (or enter keys in the UI under "Keys & models"; UI keys stay in memory only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
# Optional overrides
# MOOT_CLAUDE_MODEL=claude-opus-5-5
# MOOT_OPENAI_MODEL=gpt-5
# MOOT_GROQ_MODEL=qwen/qwen3.8-27b   # also available on this key: openai/gpt-oss-120b
# MOOT_GLM_MODEL=glm-5.2
# MOOT_GLM_BASE_URL=https://api.z.ai/api/paas/v4/   # mainland China: https://open.bigmodel.cn/api/paas/v4/
# Required for a non-loopback Manufact MCP HTTP endpoint; also used by the demo client.
# MOOT_MCP_TOKEN=
# Manufact Cloud API key (dashboard → API keys); used by ../deploy_manufact.sh and mapped to MCP_USE_API_KEY.
# MANUFACT_API_KEY=

# Primitive agent-to-agent coordination (set MOOT_COMMUNICATION=primitive to enable)
# PRIMITIVE_API_KEY=
# PRIMITIVE_DOMAIN=your-domain.com  # auto-generates addresses like moot-main-agent@your-domain.com
# PRIMITIVE_IDENTITIES_JSON={"moot-main-agent":"main@your-domain.com","claude_opus":"claude@your-domain.com"}  # optional custom mapping
# PRIMITIVE_SIGNING_SECRET=  # defaults to PRIMITIVE_API_KEY if not set
# PRIMITIVE_REPLY_TIMEOUT=600
